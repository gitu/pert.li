{
  "name": "pert.li",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:pwa": "VITE_PWA_ENABLED=1 vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "vitest run -c vitest.eval.config.ts",
    "eval:summary": "node scripts/eval-summary.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "screenshots": "E2E_SCREENSHOTS=1 playwright test --project=screenshots",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "secrets:check": "node scripts/check-secret-leak.mjs",
    "secrets:check:build": "pnpm build && node scripts/check-secret-leak.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook --url http://localhost:6006",
    "storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"storybook dev -p 6006 --ci --quiet\" \"wait-on -l tcp:6006 && test-storybook --url http://localhost:6006\"",
    "screenshots:diff": "node scripts/diff-screenshots.mjs"
  },
