# Database. Leave both unset for the zero-config local PGLite at ./.data/pglite
# (the default for `pnpm dev`). Set DATABASE_URL to a Postgres URL to use a
# real database, or set USE_NEON_PROVISION=1 to re-enable Neon Launchpad
# auto-provisioning (which also fills DATABASE_URL for you).
DATABASE_URL=
DATABASE_URL_POOLER=
USE_NEON_PROVISION=

# Where the local PGLite data lives. Only used when DATABASE_URL is unset.
LOCAL_PGLITE_DIR=./.data/pglite

# LLM provider — set one of these (auto-detect order: Anthropic → OpenAI → Gemini).
# Set LLM_PROVIDER=openai|anthropic|gemini and LLM_MODEL=<id> to override.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional: point the OpenAI adapter at any OpenAI-compatible /v1 endpoint
# (Azure OpenAI, OpenRouter, LM Studio, Ollama, vLLM, llama.cpp, …).
# Leave unset to use https://api.openai.com/v1.
OPENAI_BASE_URL=

# Better Auth
BETTER_AUTH_SECRET=

# Resend (magic-link sender). Must be a verified @pert.li address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pert.li

# Optional: redirect the in-app /privacy route to an external URL. On-prem
# deployments typically have their own legal team and existing policy page;
# set this to point users there instead of the default built-in policy.
# Leave unset to render src/routes/privacy.tsx.
PRIVACY_POLICY_URL=

# Optional OIDC single-sign-on (custom on-prem IdP, Microsoft Entra ID / Azure AD,
# Okta, Keycloak, Authentik, etc.). Leave unset to hide the SSO button on /signin.
# Entra ID example:
#   OIDC_PROVIDER_ID=entra
#   OIDC_PROVIDER_NAME=Microsoft Entra ID
#   OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
#   OIDC_CLIENT_ID=
#   OIDC_CLIENT_SECRET=
# Callback URL to register with the IdP:
#   <app-origin>/api/auth/oauth2/callback/<OIDC_PROVIDER_ID>
OIDC_PROVIDER_ID=
OIDC_PROVIDER_NAME=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
